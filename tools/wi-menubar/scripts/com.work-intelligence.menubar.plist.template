<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.work-intelligence.menubar.plist — user LaunchAgent for WIMenuBar.

  Why this exists: WIMenuBar runs as an LSUIElement (no Dock icon). Under
  macOS memory pressure, jetsam preferentially kills LSUIElement / background
  apps to free pages. The app's own signal handlers (WILog.installSignalHandlers)
  cannot intercept SIGKILL — the kernel terminates the process before any
  user-space code runs. Result: the menubar item silently disappears, no
  crash report, no signal banner in the log, just a mid-stream stop.

  This LaunchAgent makes launchd own the lifecycle. KeepAlive=true means:
   * launchd revives the binary after ANY exit (jetsam SIGKILL, panic,
     crash, user-initiated kill, logout transition reboot).
   * ThrottleInterval=10 throttles the relaunch loop so a binary that
     crashes on every start doesn't spin the CPU.
   * RunAtLoad=true starts it once at login.

  Generated by scripts/install-launchagent.sh — DO NOT edit the installed
  copy under ~/Library/LaunchAgents/ directly; re-run the installer instead
  so the template stays in sync with what's loaded.

  Template variables: ${BINARY_PATH}, ${LOG_DIR}.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.work-intelligence.menubar</string>

    <key>ProgramArguments</key>
    <array>
        <string>${BINARY_PATH}</string>
    </array>

    <!-- Restart on any exit. With this set, jetsam SIGKILL becomes
         self-healing: the menubar item reappears within ~ThrottleInterval. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Start at user login. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Minimum interval between relaunches. Default is 10s, which is
         already the value we want — declaring it explicitly documents the
         choice and protects against any system-wide default change. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Aqua = the GUI user session. Required for SwiftUI / NSStatusItem
         / MenuBarExtra. Without this the binary can't talk to WindowServer. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <!-- Redirect stdout/stderr the binary writes BEFORE WILog finishes
         setting up its own file handle — those few hundred bytes are the
         only place a startup crash leaves a trace. Keep both, sized small. -->
    <key>StandardOutPath</key>
    <string>${LOG_DIR}/launchagent.out</string>
    <key>StandardErrorPath</key>
    <string>${LOG_DIR}/launchagent.err</string>

    <!-- Don't let launchd think the process is hung; the menubar app is
         intentionally long-lived. -->
    <key>ExitTimeOut</key>
    <integer>5</integer>

    <!-- Run in user context (the user's Aqua session) — implicit when this
         plist lives in ~/Library/LaunchAgents/, but documented here too. -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
