                <mxCell id="cur_rank_ref" value="src/services/board/ranker.ts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontColor=#37474f;fontSize=9;fontFamily=Courier New;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
                    <mxGeometry x="70" y="691" width="1090" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="cur_query" value="4 · QUERY — /pm next  · GET /api/board/backlog → { top_task_id, backlog[] } · Answers &#39;what should I work on next?&#39;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="70" y="731" width="1090" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="cur_query_ref" value="web-server.js /api/board/backlog · /pm next handler" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontColor=#37474f;fontSize=9;fontFamily=Courier New;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
                    <mxGeometry x="70" y="823" width="1090" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="cur_board" value="WI KANBAN BOARD — /board (ADR-040)  · Card lives here until a human promotes it OR archives it · Columns: pending · in_progress · shipped · blocked · deferred" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d1c4e9;strokeColor=#5e35b1;fontColor=#311b92;fontSize=10;fontStyle=1;verticalAlign=middle;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="70" y="863" width="1090" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="cur_worker" value="5 · WORKER — BoardWorkerAgent  · Picks up cards with intent=&#39;execute&#39; (promoted / re-curated) · Dispatches BACK through /wi EXECUTE (recursive) · Deliberative cards wait for a human decision first" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="70" y="963" width="1090" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="cur_worker_ref" value="src/intelligence/board-worker-agent.ts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontColor=#37474f;fontSize=9;fontFamily=Courier New;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
                    <mxGeometry x="70" y="1065" width="1090" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="cur_reality" value="⚠ REALITY (2026-07-25)  0 cypher_sessions rows with outcome=&#39;captured_to_board&#39; in last 30d. The branch exists but is empirically quiet. Either users are typing &#39;doing&#39; verbs, or the classifier maps them all to execute-intents." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;dashed=1;fillColor=#eceff1;strokeColor=#78909c;fontColor=#37474f;fontSize=10;fontStyle=2;verticalAlign=middle;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="70" y="1105" width="1090" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="cur_e1" value="intent ∈ {brainstorm,plan,decide}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#1b5e20;fontStyle=1;" parent="1" source="cur_route" target="cur_capture" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cur_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;fontColor=#263238;" parent="1" source="cur_capture" target="cur_prio" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cur_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;fontColor=#263238;" parent="1" source="cur_prio" target="cur_rank" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cur_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;fontColor=#263238;" parent="1" source="cur_rank" target="cur_query" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cur_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#455a64;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;fontColor=#263238;" parent="1" source="cur_query" target="cur_board" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="cur_e6" value="promote (intent→execute)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1565c0;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#0d3c78;fontStyle=1;" parent="1" source="cur_board" target="cur_worker" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="panel_proposed" value="PROPOSED — what PM routing should look like (EDIT THIS COLUMN)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff8e1;strokeColor=#f57c00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#e65100;" parent="1" vertex="1">
                    <mxGeometry x="1210" y="120" width="1150" height="1300" as="geometry"/>
                </mxCell>
                <mxCell id="prop_intro" value="Placeholder starter — the user drives what goes here. Suggested framing: PM routing currently sees 0 traffic. Is that because the classifier is wrong, or because the flow is discouraging?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;dashed=1;fillColor=#ffffff;strokeColor=#f57c00;fontColor=#e65100;fontSize=10;fontStyle=2;verticalAlign=middle;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="170" width="1090" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="prop_slot1" value="PROPOSED STEP 1 (edit me)  e.g. &#39;Auto-suggest capture when SCOPE detects a deliberative shape even if intent came back as &quot;other&quot;. If refined_goal.target contains words like &quot;approach&quot;, &quot;strategy&quot;, &quot;options&quot;, offer capture as a one-click choice instead of forcing execute.&#39;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff3e0;strokeColor=#f57c00;fontColor=#bf360c;fontSize=10;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="260" width="1090" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="prop_slot2" value="PROPOSED STEP 2 (edit me)  e.g. &#39;Show captured card back to the user with the ID + a link. Currently the session just closes silently with outcome=captured. User has to check /board to see if anything happened. Emit an SSE event.&#39;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff3e0;strokeColor=#f57c00;fontColor=#bf360c;fontSize=10;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="370" width="1090" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="prop_slot3" value="PROPOSED STEP 3 (edit me)  e.g. &#39;Auto-prioritize on capture based on Stage 1 recognition. If the goal semantically overlaps with recently-shipped work, priority=high (it&#39;s a follow-up); if it&#39;s a green-field &quot;explore X&quot; goal, priority=low.&#39;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff3e0;strokeColor=#f57c00;fontColor=#bf360c;fontSize=10;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="480" width="1090" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="prop_slot4" value="PROPOSED STEP 4 (edit me)  e.g. &#39;BoardWorker → re-dispatch flow: when a card is promoted, the original session_id should be linked so we can see the thinking→doing chain. Today the two sessions are unrelated in cypher_sessions.&#39;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff3e0;strokeColor=#f57c00;fontColor=#bf360c;fontSize=10;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="590" width="1090" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="prop_slot5" value="PROPOSED STEP 5 (edit me)  e.g. &#39;Add a 5-minute cool-down before BoardWorker re-dispatches a promoted card, so a human can veto if the promotion was accidental. Current design lets an autonomous loop close-then-execute in seconds.&#39;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff3e0;strokeColor=#f57c00;fontColor=#bf360c;fontSize=10;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="700" width="1090" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="prop_slot6" value="PROPOSED STEP 6 (edit me)  e.g. &#39;Instrument WHY the branch is quiet. Add a counter for shouldCaptureToBoard() decisions per outcome value; if 0/N are capturing, the classifier is the problem, not the flow.&#39;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff3e0;strokeColor=#f57c00;fontColor=#bf360c;fontSize=10;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="810" width="1090" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="prop_slot7" value="PROPOSED STEP 7 (add more as needed)  Add / remove / reorder slots freely. Once we lock this column, we&#39;ll walk it left-to-right and file the deltas as ADR-043 amendments or a new ADR." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;dashed=1;fillColor=#ffffff;strokeColor=#f57c00;fontColor=#e65100;fontSize=10;fontStyle=2;verticalAlign=middle;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="920" width="1090" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="prop_legend" value="How to use this column: 1. Reply with the shape you want (edit any slot&#39;s text or say &#39;add slot for X&#39;). 2. I&#39;ll redraw this column to match. 3. Once locked, we&#39;ll audit ADR-043 against it and file the deltas." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff8e1;strokeColor=#f57c00;fontColor=#bf360c;fontSize=10;fontStyle=1;verticalAlign=middle;align=left;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="1340" width="1090" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="pm_divider" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bdbdbd;strokeColor=#bdbdbd;" parent="1" vertex="1">
                    <mxGeometry x="1195" y="120" width="5" height="1300" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
