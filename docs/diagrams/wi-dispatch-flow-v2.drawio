                <mxCell id="cur_rank" value="3 · RANK — scored backlog list  · ranker.ts computes score = f(priority, effort, staleness, deps) · Explicit contribution breakdown per card (auditable)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f5e9;strokeColor=#2e7d32;fontColor=#1b5e20;fontSize=11;verticalAlign=middle;align=center;" parent="1" vertex="1">
