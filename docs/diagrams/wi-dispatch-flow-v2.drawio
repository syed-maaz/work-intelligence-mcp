                <mxCell id="cur_route_ref" value="loop.ts:1670 · task-memory.ts REFINED_INTENT_TO_PM_INTENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontColor=#37474f;fontSize=9;fontFamily=Courier New;verticalAlign=middle;align=left;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
