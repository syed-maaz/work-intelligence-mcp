{
  "version": "1.0",
  "connectors": {
    "jira": {
      "enabled": false,
      "mode": "mcp",
      "mcp": {
        "clientName": "jira",
        "url": "",
        "tokenEnvVar": "JIRA_MCP_TOKEN"
      },
      "browser": {
        "baseUrl": "",
        "profilePathEnvVar": "BROWSER_PROFILE_PATH",
        "headlessEnvVar": "BROWSER_HEADLESS"
      },
      "defaultList": "my-issues",
      "boardUrl": ""
    },
    "github": {
      "enabled": false,
      "mode": "api",
      "mcp": {
        "url": "",
        "tokenEnvVar": "GITHUB_MCP_TOKEN"
      },
      "api": {
        "baseUrl": "https://api.github.com",
        "tokenEnvVar": "GITHUB_TOKEN"
      },
      "enterpriseHost": ""
    },
    "slack": {
      "enabled": false,
      "mode": "api",
      "api": {
        "tokenEnvVar": "SLACK_TOKEN",
        "teamIdEnvVar": "SLACK_TEAM_ID"
      }
    },
    "linear": {
      "enabled": false,
      "mode": "api",
      "api": {
        "apiKeyEnvVar": "LINEAR_API_KEY"
      }
    },
    "teams": {
      "enabled": false,
      "mode": "browser",
      "browser": {
        "profilePathEnvVar": "BROWSER_PROFILE_PATH",
        "headlessEnvVar": "BROWSER_HEADLESS"
      },
      "graph": {
        "tenantIdEnvVar": "AZURE_TENANT_ID",
        "clientIdEnvVar": "AZURE_CLIENT_ID",
        "clientSecretEnvVar": "AZURE_CLIENT_SECRET"
      }
    },
    "outlook": {
      "enabled": false,
      "mode": "browser",
      "browser": {
        "profilePathEnvVar": "BROWSER_PROFILE_PATH",
        "headlessEnvVar": "BROWSER_HEADLESS"
      },
      "graph": {
        "tenantIdEnvVar": "AZURE_TENANT_ID",
        "clientIdEnvVar": "AZURE_CLIENT_ID",
        "clientSecretEnvVar": "AZURE_CLIENT_SECRET"
      }
    }
  },
  "repos": [],
  "mempalace": {
    "pathEnvVar": "MEMPALACE_PATH",
    "embeddingsProvider": "ollama",
    "ollamaModel": "nomic-embed-text"
  },
  "database": {
    "pathEnvVar": "DATABASE_PATH"
  },
  "bridge": {
    "port": 3132,
    "allowedOriginsEnvVar": "MCP_BRIDGE_ALLOWED_ORIGINS",
    "tokenEnvVar": "MCP_BRIDGE_TOKEN"
  },
  "features": {
    "cypherLoopEnabled": false,
    "pmOrchestrationEnabled": false,
    "pmAgentEnabled": false,
    "stage1Enabled": false,
    "syncIntervalMs": 900000
  }
}