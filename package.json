{
  "name": "work-intelligence-mcp",
  "version": "0.1.0",
  "description": "MCP server for work intelligence - integrates Microsoft Graph and Jira with AI-powered insights",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "npm rebuild better-sqlite3",
    "dev": "node --env-file=.env --import tsx/esm --watch src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ux": "vitest run tests/lib tests/tools/search-all-sort.test.ts tests/brain/evidence-schema.test.ts",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "config:validate": "node scripts/config-validate.mjs",
    "setup": "node scripts/setup.mjs",
    "demo": "node --import tsx/esm scripts/seed-demo.mjs",
    "demo:trace": "node --import tsx/esm scripts/demo-loop-trace.mjs",
    "demo:eval": "node --import tsx/esm scripts/demo-eval.mjs",
    "docs:start": "cd docs && npm start",
    "docs:build": "cd docs && npm run build",
    "docs:install": "cd docs && npm install",
    "report": "node --env-file=.env --import tsx/esm src/scripts/jira-report.ts",
    "metrics:weekly": "node --env-file=.env --import tsx/esm scripts/weekly-metrics.js",
    "outlook-test": "node --env-file=.env --import tsx/esm src/scripts/outlook-test.ts",
    "teams-sync": "node --env-file=.env --import tsx/esm src/scripts/teams-sync.ts",
    "web:bridge": "node --env-file=.env web-server.js",
    "web:dev": "cd web && npm run dev",
    "web:install": "cd web && npm install",
    "menubar:build": "cd tools/wi-menubar && swift build -c release && bash scripts/bundle.sh",
    "menubar:run": "npm run menubar:build && open tools/wi-menubar/WIMenuBar.app",
    "menubar:clean": "cd tools/wi-menubar && rm -rf .build .swiftpm WIMenuBar.app",
    "menubar:autostart:on": "npm run menubar:build && bash tools/wi-menubar/scripts/install-launchagent.sh",
    "menubar:autostart:off": "bash tools/wi-menubar/scripts/uninstall-launchagent.sh",
    "menubar:autostart:status": "launchctl print gui/$(id -u)/com.work-intelligence.menubar 2>/dev/null | head -40 || echo 'not installed — run: npm run menubar:autostart:on'",
    "mcp-setup": "node --env-file=.env --import tsx/esm scripts/mcp-setup.ts",
    "build:mode-eval": "node --import tsx/esm scripts/build-mode-eval.ts",
    "palace:rebuild": "tsx --env-file=.env scripts/palace-rebuild.ts",
    "check:palace": "tsx --env-file=.env scripts/check-palace.ts",
    "smoke:bridge": "bash scripts/smoke-bridge.sh",
    "smoke:pm": "bash scripts/smoke-pm.sh",
    "smoke:pm:scenarios": "bash scripts/smoke-pm-scenarios.sh",
    "smoke:pm:phase3": "bash scripts/smoke-pm-phase3.sh",
    "smoke:stage1": "bash scripts/smoke-stage1.sh",
    "smoke:doc-embeddings": "bash scripts/smoke-doc-embeddings.sh",
    "smoke:stage1:e2e": "bash scripts/smoke-stage1-e2e.sh",
    "stage1:baseline": "node scripts/paraphrase-baseline.mjs",
    "stage1:realwork": "node scripts/stage1-realwork.mjs",
    "stage1:livework": "node scripts/stage1-livework.mjs",
    "smoke:bridge:record": "bash scripts/smoke-bridge.sh && node scripts/record-smoke-green.mjs",
    "smoke:bridge:ts": "vitest run --config scripts/smoke/vitest.config.ts",
    "canary:heartbeat": "bash scripts/smoke-heartbeat.sh",
    "smoke:outcome": "bash scripts/smoke-outcome.sh",
    "smoke:killswitch": "bash scripts/smoke-killswitch.sh",
    "smoke:bug-killswitch": "bash scripts/smoke-bug-killswitch.sh",
    "smoke:bug-resolver-killswitch": "bash scripts/smoke-bug-resolver-killswitch.sh",
    "smoke:fetcher": "bash scripts/smoke-fetcher.sh",
    "smoke:tool-catalog": "node --import tsx/esm scripts/smoke-tool-catalog.ts",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "smoke:all": "npm run smoke:bridge && npm run smoke:outcome && npm run smoke:bridge:ts && npm run smoke:killswitch && npm run smoke:bug-killswitch && npm run smoke:bug-resolver-killswitch && npm run smoke:tool-catalog && npm run smoke:ui",
    "adr-039:check": "bash scripts/adr-039-dogfood-check.sh",
    "wi:opro:dry-run": "bash scripts/wi-opro-dry-run.sh"
  },
  "keywords": [
    "mcp",
    "microsoft-graph",
    "jira",
    "ai",
    "work-intelligence"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.10.0",
    "keytar": "^7.9.0",
    "linkedom": "^0.18.12",
    "minimatch": "^10.2.5",
    "p-queue": "^9.2.0",
    "playwright": "^1.59.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/turndown": "^5.0.6",
    "ajv": "^8.20.0",
    "eslint": "^9.17.0",
    "oxlint": "^0.16.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
