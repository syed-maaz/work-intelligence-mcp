# Copy this file to .env and fill in your values
# Usage: node --env-file=.env dist/server.js
#        npm run dev   (tsx already picks up .env via --env-file)

# Required — Anthropic Claude API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional — point at a proxy instead of api.anthropic.com directly
# Set baseURL to your proxy's /anthropic subpath; token comes from the proxy client.
# ANTHROPIC_BASE_URL=http://your-ai-proxy:PORT/anthropic

# Required for Teams/Outlook scraping (EP-1/EP-2/EP-3 — not yet implemented)
# Find your Chrome profile path at chrome://version → "Profile Path"
BROWSER_PROFILE_PATH=/path/to/your/chrome/default/profile
BROWSER_HEADLESS=true
# BROWSER_EXECUTABLE=/path/to/your/chrome

# Optional — Jira (if you use it)
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

JIRA_SOURCE=mcp
JIRA_MCP_TOKEN=your_jira_mcp_token_here

# Optional — GitHub (if you use it)
# GITHUB_TOKEN=your_github_token

# Optional — Slack (Web API, if you use it)
# SLACK_TOKEN=xoxb-your-bot-token

# Optional — Linear (GraphQL API, if you use it)
# LINEAR_API_KEY=lin_your_key   

# Optional — override defaults
# SYNC_INTERVAL_MS=900000

OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# ── OP-4 / A-1: bridge security ─────────────────────────────────────────────
# CORS allow-list. The bridge will only echo back Origin values in this list.
# Anything else gets no CORS headers → the browser blocks the response.
# Default (when unset): http://localhost:5175, http://127.0.0.1:5175 (the Vite dev server).
# MCP_BRIDGE_ALLOWED_ORIGINS=http://localhost:5175,http://localhost:3000

# Optional bearer token. When set, ALL requests (except OPTIONS and same-origin
# from MCP_BRIDGE_ALLOWED_ORIGINS) must send: `Authorization: Bearer <token>`.
# Strongly recommended once you're stable. Atlas / MCP clients pass it in the
# header; the web UI on the allow-listed origin is exempt.
# MCP_BRIDGE_TOKEN=change-me-to-a-long-random-string

# ADR-037 Phase 3 — Cypher loop controller (default off until Phase 6 cutover)
CYPHER_LOOP_ENABLED=0
# Phase 2-soft trigger gates (D15 / Q-1.10). Both must clear for the plan
# to auto-proceed; otherwise dispatch falls back to Phase 1 (explicit confirm).
CYPHER_PHASE2_COUNT_MIN=3
CYPHER_PHASE2_RATE_MIN=0.8
# Phase 2-soft veto window in ms (D16). Sleep after plan render before the
# first tool call fires; interruptible by /stop. 0 disables (trusted batch).
CYPHER_PHASE2_VETO_DELAY_MS=3000
# Per-session override (D15). Empty = honor count/rate gates.
# 'auto' = skip Phase 1 wait; 'always' = force Phase 1 regardless of priors.
CYPHER_CONFIRM_MODE=
# Suppress the [engine: loop|pipeline] prefix on the first stream chunk (D20).
# Set to 1 once Phase 4 dual-engine rollback signaling is no longer useful.
CYPHER_HIDE_ENGINE_BADGE=

# ── ADR-043 PM Orchestration Layer ──────────────────────────────────────────
# Phase 1+2 (ranker, /pm skill, board endpoints). Default 0. When 0 the board
# runs on ADR-040 semantics; POST /api/board/tasks + GET /api/board/backlog +
# the BoardWorkerAgent rank ordering are gated on this.
PM_ORCHESTRATION_ENABLED=0
# Phase 3 Shape A — PMAgent tenant (backlog rank refresh + stall flagging).
# Default 0 (opt-in). Rollback = 0 + restart. Never dispatches; NOT a worker.
PM_AGENT_ENABLED=0
# PMAgent tick cadence in ms. Default 30000 (mirrors BoardWorkerAgent).
PM_AGENT_INTERVAL_MS=30000
# Days a card may sit in `ready` before PMAgent flags it stalled=1. Default 14.
PM_STALL_DAYS=14
# NOTE (AC-A1): the Cypher Stage-1 intent-routing capture hook is ALSO gated on
# WI_STAGE1_ENABLED=1 (ADR-042). With both PM_ORCHESTRATION_ENABLED=1 AND
# WI_STAGE1_ENABLED=1, a /wi goal whose refined intent is brainstorm|plan|decide
# is filed to the PM backlog (outcome='captured_to_board') instead of dispatched.

